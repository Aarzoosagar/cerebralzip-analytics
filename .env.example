# Which agent implementation to use: "llm" or "fallback"
AGENT_MODE=llm

# Groq API key for the LLM agent. Leave blank in version control.
GROQ_API_KEY=

# Groq model name to use for the LLM agent.
LLM_MODEL=llama-3.1-8b-instant

# How long to wait for the LLM before giving up (used later for
# fallback-on-timeout behavior).
LLM_TIMEOUT_SECONDS=20

# Path to the SQLite database file inside the container.
DATABASE_PATH=/app/data/olist.db

# Directory for downloaded CSVs and the runtime SQLite database.
DATA_DIR=/app/data

# FastAPI bind host/port.
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
